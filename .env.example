# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://lprmtbpgrzvuyrpanogy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<a_remplir>
SUPABASE_SERVICE_ROLE_KEY=<a_remplir>

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<a_remplir>
STRIPE_SECRET_KEY=<a_remplir>
STRIPE_WEBHOOK_SECRET=<a_remplir>

# App URLs (OBLIGATOIRE en production — évite les fallbacks localhost)
NEXT_PUBLIC_APP_URL=https://k-share.fr
NEXT_PUBLIC_SITE_URL=https://k-share.fr

# Sentry
NEXT_PUBLIC_SENTRY_DSN=<a_remplir>

# Resend (emails)
RESEND_API_KEY=<a_remplir>

# CRON secret (min 16 chars)
CRON_SECRET=<a_remplir>

# Anthropic (support IA)
ANTHROPIC_API_KEY=<a_remplir>

# Identité légale de l'émetteur des factures (mentions obligatoires — CGI ann. II
# art. 242 nonies A, et code de commerce art. R123-237 / L526-22 pour l'EI).
# Sans elles, l'espace de gestion refuse d'émettre : une facture qui les omet est
# irrégulière. Le nom commercial ne remplace pas la dénomination légale, qui pour
# une entreprise individuelle est le nom de l'entrepreneur.
KSHARE_DENOMINATION=<nom_prenom_de_l_entrepreneur>
KSHARE_ADRESSE=<a_remplir>
KSHARE_CODE_POSTAL=<a_remplir>
KSHARE_VILLE=<a_remplir>
KSHARE_SIRET=<a_remplir>
# Facultatifs — valeurs par défaut entre parenthèses.
KSHARE_NOM_COMMERCIAL=            # (Kshare)
KSHARE_MENTION_EI=                # (Entrepreneur individuel)
KSHARE_IMMATRICULATION=           # (Dispensé d'immatriculation au RCS et au RM)
