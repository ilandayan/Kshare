# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Windows reserved device name (can appear as a real file on NTFS via Unix tools)
nul

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Sentry Config File
.env.sentry-build-plugin

# Artefacts locaux de Claude Code.
# Les worktrees étaient suivis comme des sous-modules : celui de « festive-hofstadter »
# avait été supprimé du disque sans l'être de l'index, et chaque `git status` le
# signalait depuis. Ils n'ont rien à faire dans le dépôt, pas plus que le verrou
# des tâches planifiées, qui change à chaque exécution.
.claude/worktrees/
.claude/scheduled_tasks.lock
